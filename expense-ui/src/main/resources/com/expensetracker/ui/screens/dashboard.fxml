<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.expensetracker.ui.screens.dashboard.DashboardController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            styleClass="dashboard-scroll">

    <VBox spacing="28"
          styleClass="dashboard-content">

        <!-- Dashboard heading and selected profile -->
        <HBox alignment="CENTER_LEFT" spacing="16">

            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Dashboard"
                       styleClass="dashboard-heading"/>

                <Label text="Your spending at a glance"
                       styleClass="dashboard-subtitle"/>
            </VBox>

            <VBox spacing="5"
                  alignment="CENTER_RIGHT"
                  styleClass="dashboard-profile">

                <Label text="User: —"
                       fx:id="userLabel"
                       styleClass="profile-user"/>

                <Label text="Profile: —"
                       fx:id="profileLabel"
                       styleClass="profile-name"/>
            </VBox>
        </HBox>

        <!-- Expense summaries -->
        <VBox spacing="14">

            <Label text="Spending Overview"
                   styleClass="dashboard-section-heading"/>

            <HBox spacing="14">

                <VBox spacing="12"
                      maxWidth="Infinity"
                      HBox.hgrow="ALWAYS"
                      styleClass="expense-summary-card">

                    <Label text="THIS MONTH"
                           styleClass="summary-card-title"/>

                    <Label fx:id="thisMonthLabel"
                           text="\$0.00"
                           styleClass="summary-card-value"/>
                </VBox>

                <VBox spacing="12"
                      maxWidth="Infinity"
                      HBox.hgrow="ALWAYS"
                      styleClass="expense-summary-card">

                    <Label text="LAST MONTH"
                           styleClass="summary-card-title"/>

                    <Label fx:id="lastMonthLabel"
                           text="\$0.00"
                           styleClass="summary-card-value"/>
                </VBox>

                <VBox spacing="12"
                      maxWidth="Infinity"
                      HBox.hgrow="ALWAYS"
                      styleClass="expense-summary-card">

                    <Label text="THIS YEAR"
                           styleClass="summary-card-title"/>

                    <Label fx:id="thisYearLabel"
                           text="\$0.00"
                           styleClass="summary-card-value"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Quick action -->
        <HBox alignment="CENTER_LEFT" spacing="16">

            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Manage Expenses"
                       styleClass="dashboard-section-heading"/>

                <Label text="Record and organize your spending."
                       styleClass="dashboard-subtitle"/>
            </VBox>

            <Button text="+ Add Expense"
                onAction="#handleAddExpense"
                styleClass="dashboard-primary-button"/>
        </HBox>

        <!-- Recent expenses -->
        <VBox spacing="16"
              styleClass="recent-expenses-panel">

            <Label text="Recent Expenses"
                   styleClass="dashboard-section-heading"/>

            <!-- Populated dynamically by DashboardController -->
            <VBox fx:id="recentExpensesContainer"
                  spacing="10"
                  fillWidth="true"
                  minHeight="170"
                  styleClass="recent-expenses-list">

                <!-- Initial empty state -->
                <VBox alignment="CENTER"
                      spacing="10"
                      minHeight="170"
                      styleClass="expenses-empty-state">

                    <Label text="No expenses recorded yet"
                           styleClass="empty-state-heading"/>

                    <Label text="Your latest expenses will appear here."
                           styleClass="empty-state-description"/>
                </VBox>
            </VBox>
        </VBox>

    </VBox>
</ScrollPane>
