<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.expensetracker.ui.screens.expense.AddExpenseController"
      spacing="20"
      prefWidth="460"
      styleClass="add-expense-dialog">

    <!-- Dialog heading -->
    <VBox spacing="6">
        <Label text="Add Expense"
               styleClass="dialog-heading"/>

        <Label text="Record a new expense for your profile."
               styleClass="dialog-subtitle"/>
    </VBox>

    <!-- Expense fields -->
    <VBox spacing="16">

        <!-- Amount -->
        <VBox spacing="6">
            <Label text="Amount (USD) *"
                   styleClass="dialog-field-label"/>

            <TextField fx:id="amountField"
                       promptText="0.00"
                       styleClass="dialog-text-field"/>
        </VBox>

        <!-- Category -->
        <VBox spacing="6">
            <Label text="Category *"
                   styleClass="dialog-field-label"/>

            <ComboBox fx:id="categoryComboBox"
                      maxWidth="Infinity"
                      promptText="Select a category"
                      styleClass="dialog-combo-box"/>
        </VBox>

        <!-- Date -->
        <VBox spacing="6">
            <Label text="Transaction Date *"
                   styleClass="dialog-field-label"/>

            <DatePicker fx:id="transactionDatePicker"
                        maxWidth="Infinity"
                        styleClass="dialog-date-picker"/>
        </VBox>

        <!-- Necessity -->
        <VBox spacing="6">
            <Label text="Necessity *"
                   styleClass="dialog-field-label"/>

            <ComboBox fx:id="necessityComboBox"
                      maxWidth="Infinity"
                      promptText="Select necessity"
                      styleClass="dialog-combo-box"/>
        </VBox>

        <!-- Description -->
        <VBox spacing="6">
            <Label text="Description (optional)"
                   styleClass="dialog-field-label"/>

            <TextArea fx:id="descriptionArea"
                      promptText="What was this expense for?"
                      prefRowCount="3"
                      wrapText="true"
                      styleClass="dialog-text-area"/>
        </VBox>

    </VBox>

    <!-- Validation message -->
    <Label fx:id="validationLabel"
           visible="false"
           managed="false"
           wrapText="true"
           styleClass="dialog-validation-message"/>

    <!-- Actions -->
    <HBox alignment="CENTER_RIGHT" spacing="12">
        <Button fx:id="cancelButton"
                text="Cancel"
                onAction="#handleCancel"
                styleClass="dialog-secondary-button"/>

        <Button fx:id="saveButton"
                text="Save Expense"
                onAction="#handleSave"
                defaultButton="true"
                styleClass="dialog-primary-button"/>
    </HBox>

</VBox>
